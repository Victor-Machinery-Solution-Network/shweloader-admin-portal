# Cloudflare Worker REST API
CLOUDFLARE_WORKER_API_URL=https://api.staging.shweloader.com.mm
CLOUDFLARE_WORKER_API_TOKEN=your-secret-key-here

# Cloudflare R2 Public Asset URL (exposed to browser)
NEXT_PUBLIC_R2_PUBLIC_URL=https://asset.staging.shweloader.com.mm

# Authentication (Auth.js v5)
AUTH_SECRET=your-secret-key-here

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Set to "true" to disable Turnstile in development/testing
# NEXT_PUBLIC_DISABLE_TURNSTILE=true

# Public web app cache revalidation (fire-and-forget webhook on catalog writes).
# Set PUBLIC_SITE_URL per environment to the public site that displays the data
# this admin instance writes — prod admin → https://shweloader.com.mm,
# staging admin → https://staging.shweloader.com.mm.
# REVALIDATE_SECRET MUST match the same env's value on the public web app, or
# the webhook returns 401 and the public site silently falls back to its TTL.
# If unset, revalidation is skipped (no error) — the public site uses its TTL.
PUBLIC_SITE_URL=https://shweloader.com.mm
REVALIDATE_SECRET=your-shared-revalidate-secret

# Google Analytics 4 (server-only — never NEXT_PUBLIC).
# Numeric GA4 property id, e.g. 123456789
GA_PROPERTY_ID=
# Full service-account JSON (one line). Store as a Sensitive Vercel env var.
GA_SERVICE_ACCOUNT_KEY=
